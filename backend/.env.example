# Copy this file to .env and adjust as needed. .env is loaded automatically on startup.

PORT=8080
DB_PATH=fixit.db
UPLOAD_DIR=uploads

# HMAC secret used to sign JWTs. MUST be changed for anything beyond your own laptop demo.
JWT_SECRET=change-this-to-a-long-random-string

# Leave empty to allow any email domain to register. Set to your university's
# student email domain to restrict registration (checked as "...@<this value>").
ALLOWED_EMAIL_DOMAIN=student.sust.edu

# The first admin account is created automatically on startup if it doesn't exist yet.
ADMIN_EMAIL=admin@sust.edu
ADMIN_PASSWORD=change-this-password
